<?xml version="1.0" encoding="UTF-8"?>
<!--
	Usado pelo Hibernate (via jboss-logging). Os logs da aplicação passam pelo
	SLF4J e são configurados em log4j.properties.

	Não habilite org.hibernate.SQL em debug em produção: com volume real, o log
	cresce rápido e pode encher o disco.
-->
<Configuration status="WARN">
	<Appenders>
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n" />
		</Console>
	</Appenders>
	<Loggers>
		<Logger name="org.hibernate" level="warn" />
		<Logger name="com.mchange" level="warn" />
		<Root level="info">
			<AppenderRef ref="Console" />
		</Root>
	</Loggers>
</Configuration>
